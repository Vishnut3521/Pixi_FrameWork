{
    "compilerOptions": {
        "target": "ES2020",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "strict": true,
        "skipLibCheck": true,
        "noEmit": true,
        "resolveJsonModule": true,
        "esModuleInterop": true
    },

    "include": [
        "**/*.ts"
    ],

    "exclude": [
        "node_modules",
        "build",
        "scripts"
    ]
}